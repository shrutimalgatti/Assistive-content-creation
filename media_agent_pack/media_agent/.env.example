# Google AI Studio API key (used for Gemini text + image models).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here

# Set to TRUE to route Gemini calls through Vertex AI instead of the AI Studio
# endpoint. Requires GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION and ADC.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Output -----------------------------------------------------------------
# Write a copy of every generated image/audio file to disk (in addition to
# saving it as an ADK artifact).
SAVE_LOCALLY=True
# Directory for those local copies, relative to the package root.
LOCAL_SAVE_PATH=out

# Append each prompt-enhancement round trip to logs/prompts/.
SAVE_PROMPT_TO_FILE=True

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOGGING_LEVEL=INFO
# Set to true to unmute google.adk / httpx / urllib3 framework logs.
DETAILED_FRAMEWORK_LOGGING=False
